<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Categorias - ComprasLivre.tec</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tech-blue': '#2563eb',
                        'tech-dark': '#0f172a',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">
    <!-- Header Admin -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fas fa-microchip text-tech-blue text-2xl"></i>
                <span class="font-bold text-xl text-slate-800 tracking-tight">ComprasLivre<span class="text-tech-blue">.tec</span></span>
                <span class="ml-2 px-2 py-0.5 bg-blue-100 text-tech-blue text-xs font-bold rounded-full">ADMIN</span>
            </div>
            <nav class="hidden md:flex gap-6">
                <a href="/admin/produtos" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-list mr-1"></i> Produtos</a>
                <a href="/admin/produtos/novo" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-plus mr-1"></i> Cadastrar</a>
                <a href="/admin/categorias" class="text-sm font-bold text-tech-blue border-b-2 border-tech-blue pb-1"><i class="fas fa-tags mr-1"></i> Categorias</a>
                <a href="/admin/configuracao" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-cog mr-1"></i> Configurações</a>
                <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
                    <a href="/admin/lojas" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-store mr-1"></i> Lojas & Subadmins</a>
                <% } %>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/" class="text-sm text-slate-500 hover:text-tech-blue transition"><i class="fas fa-external-link-alt mr-1"></i> Ver Site</a>
                <div class="w-px h-4 bg-slate-200"></div>
                <a href="/admin/logout" class="text-sm text-red-500 hover:text-red-700 font-bold transition"><i class="fas fa-sign-out-alt mr-1"></i> Sair</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Gerenciar Categorias</h1>
            <p class="text-slate-500">Adicione e remova categorias de software para organizar o catálogo.</p>
        </div>

        <script>
            // Show success message
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') == '1') {
                document.write(`
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-8 rounded shadow-sm" role="alert">
                        <p class="font-bold">Cadastrado!</p>
                        <p>A categoria foi criada com sucesso.</p>
                    </div>
                `);
            } else if (urlParams.get('success') == '2') {
                document.write(`
                    <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4 mb-8 rounded shadow-sm" role="alert">
                        <p class="font-bold">Excluída!</p>
                        <p>A categoria foi removida permanentemente.</p>
                    </div>
                `);
            }
        </script>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Form de Criação -->
            <div class="bg-white p-6 rounded-xl shadow-lg border border-slate-100 h-fit">
                <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                    <i class="fas fa-plus-circle text-tech-blue"></i> Nova Categoria
                </h2>
                <form action="/admin/categorias" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Nome da Categoria *</label>
                        <input type="text" name="name" required placeholder="Ex: Programação" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue focus:border-tech-blue outline-none transition bg-white">
                    </div>
                    <button type="submit" class="w-full bg-tech-blue hover:bg-blue-700 text-white font-bold py-2 rounded-lg transition shadow-md flex items-center justify-center gap-2">
                        <i class="fas fa-save"></i> Criar Categoria
                    </button>
                </form>
            </div>

            <!-- Tabela de Categorias -->
            <div class="md:col-span-2 bg-white rounded-xl shadow-lg border border-slate-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-600 text-sm uppercase tracking-wider">
                                <th class="p-4 font-semibold border-b border-slate-200">ID</th>
                                <th class="p-4 font-semibold border-b border-slate-200">Nome</th>
                                <th class="p-4 font-semibold border-b border-slate-200 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(function(category) { %>
                                    <tr class="hover:bg-slate-50 transition">
                                        <td class="p-4 text-sm font-mono text-slate-400">#<%= category.id %></td>
                                        <td class="p-4 font-bold text-slate-800"><%= category.name %></td>
                                        <td class="p-4 text-right">
                                            <form action="/admin/categorias/excluir/<%= category.id %>" method="POST" class="inline" onsubmit="return confirm('Tem certeza que deseja excluir esta categoria? Isso removerá a associação de todos os produtos dela.');">
                                                <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition" title="Excluir">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="p-8 text-center text-slate-500">
                                        Nenhuma categoria cadastrada ainda.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
