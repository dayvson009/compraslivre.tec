<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações da Loja - ComprasLivre.tec</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tech-blue': '#2563eb',
                        'tech-dark': '#0f172a',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">
    <!-- Header Admin -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fas fa-microchip text-tech-blue text-2xl"></i>
                <span class="font-bold text-xl text-slate-800 tracking-tight">ComprasLivre<span class="text-tech-blue">.tec</span></span>
                <span class="ml-2 px-2 py-0.5 bg-blue-100 text-tech-blue text-xs font-bold rounded-full">ADMIN</span>
            </div>
            <nav class="hidden md:flex gap-6">
                <a href="/admin/produtos" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-list mr-1"></i> Produtos</a>
                <a href="/admin/produtos/novo" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-plus mr-1"></i> Cadastrar</a>
                <a href="/admin/categorias" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-tags mr-1"></i> Categorias</a>
                <a href="/admin/configuracao" class="text-sm font-bold text-tech-blue border-b-2 border-tech-blue pb-1"><i class="fas fa-cog mr-1"></i> Configurações</a>
                <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
                    <a href="/admin/lojas" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-store mr-1"></i> Lojas & Subadmins</a>
                <% } %>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/" class="text-sm text-slate-500 hover:text-tech-blue transition"><i class="fas fa-external-link-alt mr-1"></i> Ver Site</a>
                <div class="w-px h-4 bg-slate-200"></div>
                <a href="/admin/logout" class="text-sm text-red-500 hover:text-red-700 font-bold transition"><i class="fas fa-sign-out-alt mr-1"></i> Sair</a>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Configurações da Loja</h1>
            <p class="text-slate-500">Gerencie as credenciais da loja, integrações e personalize o banner de ofertas.</p>
        </div>

        <script>
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') == '1') {
                document.write(`
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-8 rounded shadow-sm" role="alert">
                        <p class="font-bold">Sucesso!</p>
                        <p>As configurações da loja foram salvas corretamente.</p>
                    </div>
                `);
            }
        </script>

        <form action="/admin/configuracao" method="POST" enctype="multipart/form-data" class="space-y-8 bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
            
            <!-- Configurações Gerais -->
            <div>
                <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center border-b pb-2"><i class="fas fa-store text-tech-blue mr-2"></i> Informações Gerais da Loja</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Nome da Loja *</label>
                        <input type="text" name="name" value="<%= store.name %>" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Subdomínio (Slug)</label>
                        <input type="text" value="<%= store.slug %>" disabled class="w-full px-4 py-2 border border-slate-200 bg-slate-100 rounded-lg text-slate-500 text-sm font-mono outline-none">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Logotipo da Loja</label>
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col md:flex-row items-center gap-4">
                            <% if (store.logo_url) { %>
                                <div class="w-24 h-24 bg-white rounded-lg border overflow-hidden flex items-center justify-center p-2 relative group shadow-sm">
                                    <img id="logo-preview-img" src="<%= store.logo_url %>" class="max-w-full max-h-full object-contain">
                                    <button type="button" onclick="removeStoreLogo()" class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs font-bold rounded-lg cursor-pointer">
                                        <i class="fas fa-trash mr-1"></i> Remover
                                    </button>
                                </div>
                            <% } %>
                            <div class="flex-grow space-y-2 w-full">
                                <input type="file" name="logoFile" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-tech-blue hover:file:bg-blue-100">
                                <input type="text" id="logoUrlInput" name="logoUrl" value="<%= store.logo_url || '' %>" placeholder="Ou digite o caminho da imagem externa (Ex: /images/LogoHeader.png)" class="w-full px-3 py-1.5 border rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-xs font-mono">
                                <input type="hidden" name="removeLogo" id="removeLogoInput" value="false">
                            </div>
                        </div>
                        <script>
                            function removeStoreLogo() {
                                if (confirm('Deseja realmente remover o logotipo atual?')) {
                                    document.getElementById('removeLogoInput').value = 'true';
                                    document.getElementById('logoUrlInput').value = '';
                                    const preview = document.getElementById('logo-preview-img');
                                    if (preview) {
                                        preview.parentElement.remove();
                                    }
                                }
                            }
                        </script>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Mercado Pago Access Token *</label>
                        <input type="text" name="mpAccessToken" value="<%= store.mp_access_token %>" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm font-mono">
                    </div>
                </div>
            </div>

            <!-- E-mail / Resend -->
            <div>
                <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center border-b pb-2"><i class="fas fa-envelope text-tech-blue mr-2"></i> Envio de E-mail (Resend)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Resend API Key</label>
                        <input type="text" name="resendApiKey" value="<%= store.resend_api_key || '' %>" placeholder="re_..." class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm font-mono">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Remetente (E-mail From)</label>
                        <input type="email" name="resendFrom" value="<%= store.resend_from || '' %>" placeholder="contato@seusite.com.br" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm">
                    </div>
                </div>
            </div>

            <!-- Configurações do Banner de Ofertas -->
            <div>
                <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center border-b pb-2"><i class="fas fa-image text-tech-blue mr-2"></i> Banner de Ofertas (Página /produtos)</h2>
                <div class="grid grid-cols-1 gap-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Produto em Destaque *</label>
                            <select name="bannerProductId" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm bg-white">
                                <option value="">Selecione um produto</option>
                                <% if(typeof products !== 'undefined' && products.length > 0) { %>
                                    <% products.forEach(function(p) { %>
                                        <option value="<%= p.id %>" <%= store.banner_product_id === p.id ? 'selected' : '' %>><%= p.name %> (R$ <%= p.price %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Horas do Cronômetro (Timer)</label>
                            <input type="number" name="bannerTimerHours" value="<%= store.banner_timer_hours || 8 %>" min="1" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Título do Banner</label>
                        <input type="text" name="bannerTitle" value="<%= store.banner_title || '' %>" placeholder="Deixe em branco para usar o nome do produto" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Subtítulo do Banner</label>
                        <input type="text" name="bannerSubtitle" value="<%= store.banner_subtitle || '' %>" placeholder="Ex: Licença vitalícia • Ativação original" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-sm">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Imagem de Fundo do Banner (Background)</label>
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col md:flex-row items-center gap-4">
                            <% if (store.banner_background_image) { %>
                                <div class="w-32 h-20 bg-slate-800 rounded-lg border overflow-hidden flex items-center justify-center p-1">
                                    <img src="<%= store.banner_background_image %>" class="max-w-full max-h-full object-contain">
                                </div>
                            <% } %>
                            <div class="flex-grow space-y-2 w-full">
                                <input type="file" name="bannerImageFile" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-tech-blue hover:file:bg-blue-100">
                                <input type="text" name="bannerBackgroundImage" value="<%= store.banner_background_image || '' %>" placeholder="Ou digite o caminho da imagem externa (Ex: /images/banner_corel.png)" class="w-full px-3 py-1.5 border rounded-lg focus:ring-2 focus:ring-tech-blue outline-none text-xs font-mono">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-200">
                <button type="submit" class="w-full bg-tech-blue hover:bg-blue-700 text-white font-bold py-4 rounded-xl text-lg transition shadow-lg flex justify-center items-center gap-2">
                    <i class="fas fa-save"></i> Salvar Configurações
                </button>
            </div>
        </form>
    </main>
</body>
</html>
