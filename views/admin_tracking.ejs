<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Tracking - ComprasLivre.tec</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tech-blue': '#2563eb',
                        'tech-dark': '#0f172a',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">
    <!-- Header Admin -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fas fa-microchip text-tech-blue text-2xl"></i>
                <span class="font-bold text-xl text-slate-800 tracking-tight">ComprasLivre<span class="text-tech-blue">.tec</span></span>
                <span class="ml-2 px-2 py-0.5 bg-blue-100 text-tech-blue text-xs font-bold rounded-full">ADMIN</span>
            </div>
            <nav class="hidden md:flex gap-6">
                <a href="/admin/produtos" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-list mr-1"></i> Produtos</a>
                <a href="/admin/produtos/novo" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-plus mr-1"></i> Cadastrar</a>
                <a href="/admin/categorias" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-tags mr-1"></i> Categorias</a>
                <a href="/admin/configuracao" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-cog mr-1"></i> Configurações</a>
                <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
                    <a href="/admin/lojas" class="text-sm font-bold text-slate-500 hover:text-tech-blue transition"><i class="fas fa-store mr-1"></i> Lojas & Subadmins</a>
                    <a href="/admin/tracking" class="text-sm font-bold text-tech-blue border-b-2 border-tech-blue pb-1"><i class="fas fa-chart-line mr-1"></i> Dashboard Tracking</a>
                <% } %>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/" class="text-sm text-slate-500 hover:text-tech-blue transition"><i class="fas fa-external-link-alt mr-1"></i> Ver Site</a>
                <div class="w-px h-4 bg-slate-200"></div>
                <a href="/admin/logout" class="text-sm text-red-500 hover:text-red-700 font-bold transition"><i class="fas fa-sign-out-alt mr-1"></i> Sair</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Métricas de Funil e Logs de Conversão</h1>
            <p class="text-slate-500">Monitore o comportamento dos visitantes e recupere vendas no X1 de clientes que não finalizaram o pagamento.</p>
        </div>

        <%
            let statsData = stats || {};
            let visitsCount = parseInt(statsData.visits) || 0;
            let clicksCount = parseInt(statsData.clicks) || 0;
            let formsCount = parseInt(statsData.forms) || 0;
            let purchasesCount = parseInt(statsData.purchases) || 0;

            let clickRate = visitsCount > 0 ? ((clicksCount / visitsCount) * 100).toFixed(1) : '0.0';
            let formRate = clicksCount > 0 ? ((formsCount / clicksCount) * 100).toFixed(1) : '0.0';
            let purchaseRate = formsCount > 0 ? ((purchasesCount / formsCount) * 100).toFixed(1) : '0.0';

            // Mobile stats
            let mVisits = parseInt(statsData.mobile_visits) || 0;
            let mClicks = parseInt(statsData.mobile_clicks) || 0;
            let mForms = parseInt(statsData.mobile_forms) || 0;
            let mPurchases = parseInt(statsData.mobile_purchases) || 0;
            let mConvRate = mVisits > 0 ? ((mPurchases / mVisits) * 100).toFixed(1) : '0.0';

            // Desktop stats
            let dVisits = parseInt(statsData.desktop_visits) || 0;
            let dClicks = parseInt(statsData.desktop_clicks) || 0;
            let dForms = parseInt(statsData.desktop_forms) || 0;
            let dPurchases = parseInt(statsData.desktop_purchases) || 0;
            let dConvRate = dVisits > 0 ? ((dPurchases / dVisits) * 100).toFixed(1) : '0.0';
        %>

        <!-- Grid de Estatísticas Gerais -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-md border border-slate-100 p-6 flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Visualizações</span>
                    <strong class="text-3xl font-bold text-slate-800"><%= visitsCount %></strong>
                </div>
                <div class="w-12 h-12 bg-slate-100 text-slate-500 rounded-lg flex items-center justify-center text-xl">
                    <i class="fas fa-eye"></i>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md border border-slate-100 p-6">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Cliques no Botão</span>
                        <strong class="text-3xl font-bold text-slate-800"><%= clicksCount %></strong>
                    </div>
                    <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-lg flex items-center justify-center text-xl">
                        <i class="fas fa-mouse-pointer"></i>
                    </div>
                </div>
                <div class="text-xs text-slate-500">
                    Taxa de cliques: <span class="font-bold text-amber-600"><%= clickRate %>%</span>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md border border-slate-100 p-6">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Leads (Preencheu Dados)</span>
                        <strong class="text-3xl font-bold text-slate-800"><%= formsCount %></strong>
                    </div>
                    <div class="w-12 h-12 bg-blue-50 text-blue-500 rounded-lg flex items-center justify-center text-xl">
                        <i class="fas fa-user-tag"></i>
                    </div>
                </div>
                <div class="text-xs text-slate-500">
                    Cliques -> Leads: <span class="font-bold text-blue-600"><%= formRate %>%</span>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md border border-slate-100 p-6">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Vendas Concluídas</span>
                        <strong class="text-3xl font-bold text-slate-800"><%= purchasesCount %></strong>
                    </div>
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-lg flex items-center justify-center text-xl">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
                <div class="text-xs text-slate-500">
                    Leads -> Vendas: <span class="font-bold text-emerald-600"><%= purchaseRate %>%</span>
                </div>
            </div>
        </div>

        <!-- Análise Comparativa Celular vs PC -->
        <div class="bg-white rounded-xl shadow-md border border-slate-100 p-6 mb-10">
            <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <i class="fas fa-chart-bar text-tech-blue"></i> Funil de Vendas por Dispositivo (Celular vs. PC)
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Mobile Funnel -->
                <div class="border border-slate-100 rounded-lg p-5 bg-gradient-to-br from-slate-50 to-blue-50/20">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-bold text-slate-700 flex items-center gap-2">
                            <i class="fas fa-mobile-alt text-2xl text-blue-500"></i> Celular (Mobile)
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                            Conversão: <%= mConvRate %>%
                        </span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-center">
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Acessos</span>
                            <strong class="text-lg text-slate-700"><%= mVisits %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Cliques</span>
                            <strong class="text-lg text-slate-700"><%= mClicks %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Leads</span>
                            <strong class="text-lg text-slate-700"><%= mForms %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Vendas</span>
                            <strong class="text-lg text-emerald-600"><%= mPurchases %></strong>
                        </div>
                    </div>
                </div>

                <!-- Desktop Funnel -->
                <div class="border border-slate-100 rounded-lg p-5 bg-gradient-to-br from-slate-50 to-indigo-50/20">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-bold text-slate-700 flex items-center gap-2">
                            <i class="fas fa-desktop text-2xl text-indigo-500"></i> Computador (Desktop)
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-100 text-indigo-700">
                            Conversão: <%= dConvRate %>%
                        </span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-center">
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Acessos</span>
                            <strong class="text-lg text-slate-700"><%= dVisits %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Cliques</span>
                            <strong class="text-lg text-slate-700"><%= dClicks %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Leads</span>
                            <strong class="text-lg text-slate-700"><%= dForms %></strong>
                        </div>
                        <div class="bg-white p-2 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Vendas</span>
                            <strong class="text-lg text-emerald-600"><%= dPurchases %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Show success message if parameter ?success=deleted
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') === 'deleted') {
                document.write(`
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-8 rounded shadow-sm" role="alert">
                        <p class="font-bold">Sucesso!</p>
                        <p>Os logs selecionados foram excluídos com sucesso do banco de dados.</p>
                    </div>
                `);
            }
        </script>

        <!-- Logs de Atividade por IP -->
        <div class="bg-white rounded-xl shadow-lg border border-slate-100 overflow-hidden">
            <div class="p-6 border-b border-slate-100 bg-slate-50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h3 class="text-lg font-bold text-slate-800">Histórico de Atividade Agrupado por IP</h3>
                    <p class="text-xs text-slate-500">Veja o caminho percorrido pelo cliente até a compra e onde ele está desistindo.</p>
                </div>
                <button type="submit" form="delete-logs-form" id="delete-selected-btn" class="bg-red-500 hover:bg-red-600 disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none text-white font-bold py-2 px-4 rounded-lg text-xs transition flex items-center gap-1.5 shadow-md shadow-red-500/10 cursor-pointer disabled:cursor-not-allowed" disabled>
                    <i class="fas fa-trash-alt"></i> Excluir Selecionados (<span id="selected-count">0</span>)
                </button>
            </div>

            <form id="delete-logs-form" action="/admin/tracking/delete" method="POST">
                <div class="p-4 bg-slate-100 border-b border-slate-200 flex items-center gap-2 text-xs text-slate-600">
                    <input type="checkbox" id="select-all-checkbox" class="w-4 h-4 rounded text-tech-blue border-slate-300 focus:ring-tech-blue cursor-pointer">
                    <span class="font-bold">Selecionar todos os IPs</span>
                </div>
                <div class="divide-y divide-slate-100">
                    <% if (logs && logs.length > 0) { %>
                        <% logs.forEach(function(group, idx) { %>
                            <div class="p-5 hover:bg-slate-50/50 transition">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <!-- Left side: Checkbox, IP, Device, Store, Time -->
                                    <div class="flex items-start gap-3">
                                        <input type="checkbox" name="logIds[]" value="<%= group.log_ids.join(',') %>" class="log-item-checkbox mt-1 w-4 h-4 rounded text-tech-blue border-slate-300 focus:ring-tech-blue cursor-pointer">
                                        <div>
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <strong class="text-slate-800 font-mono text-sm"><%= group.ip_address %></strong>
                                                
                                                <% if (group.device === 'Mobile') { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-100">
                                                        <i class="fas fa-mobile-alt"></i> Celular
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-600 border border-indigo-100">
                                                        <i class="fas fa-desktop"></i> Desktop
                                                    </span>
                                                <% } %>

                                                <span class="text-xs px-2 py-0.5 bg-slate-100 text-slate-600 rounded-full font-medium"><%= group.store_name %></span>
                                            </div>
                                            
                                            <!-- Funnel Steps Visual Stepper -->
                                            <div class="flex items-center gap-1.5 mt-2 flex-wrap text-[11px]">
                                                <% 
                                                    let hasVisited = group.activities.some(a => a.event_type === 'visited');
                                                    let hasClicked = group.activities.some(a => a.event_type === 'clicked_checkout');
                                                    let hasSubmitted = group.activities.some(a => a.event_type === 'form_submitted');
                                                    let hasPaid = group.purchased;
                                                %>
                                                
                                                <!-- Step 1: Visit -->
                                                <span class="flex items-center gap-1 font-bold <%= hasVisited ? 'text-blue-600' : 'text-slate-300' %>">
                                                    <i class="fas <%= hasVisited ? 'fa-check-circle' : 'fa-circle' %>"></i> Acessou
                                                </span>
                                                <i class="fas fa-chevron-right text-[8px] text-slate-300"></i>

                                                <!-- Step 2: Clicked Purchase -->
                                                <span class="flex items-center gap-1 font-bold <%= hasClicked ? 'text-amber-600' : 'text-slate-300' %>">
                                                    <i class="fas <%= hasClicked ? 'fa-check-circle' : 'fa-circle' %>"></i> Clicou
                                                </span>
                                                <i class="fas fa-chevron-right text-[8px] text-slate-300"></i>

                                                <!-- Step 3: Lead Submitted -->
                                                <span class="flex items-center gap-1 font-bold <%= hasSubmitted ? 'text-indigo-600' : 'text-slate-300' %>">
                                                    <i class="fas <%= hasSubmitted ? 'fa-check-circle' : 'fa-circle' %>"></i> Dados
                                                </span>
                                                <i class="fas fa-chevron-right text-[8px] text-slate-300"></i>

                                                <!-- Step 4: Paid -->
                                                <span class="flex items-center gap-1 font-bold <%= hasPaid ? 'text-emerald-600' : 'text-slate-300' %>">
                                                    <i class="fas <%= hasPaid ? 'fa-check-circle' : 'fa-circle' %>"></i> Pago 🎉
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right side: Contact Details, WhatsApp Downsell, Activity details toggle -->
                                    <div class="flex items-center gap-3 justify-between md:justify-end">
                                        <div class="text-right hidden md:block">
                                            <% if (group.email) { %>
                                                <div class="text-xs text-slate-600 font-medium"><%= group.email %></div>
                                            <% } %>
                                            <% if (group.whatsapp) { %>
                                                <div class="text-xs text-slate-500 font-mono"><%= group.whatsapp %></div>
                                            <% } %>
                                            <div class="text-[10px] text-slate-400 mt-0.5">
                                                Último: <%= new Date(group.last_activity).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center gap-2">
                                            <% if (group.whatsapp && !group.purchased) { %>
                                                <% 
                                                    const rawPhone = group.whatsapp.replace(/\D/g, '');
                                                    const lastProduct = group.activities[0]?.product_name || 'Produto';
                                                    const message = `Olá, tudo bem? Vi que você se interessou pelo ${lastProduct} no nosso site mas acabou não finalizando a compra. Consegui liberar uma condição especial ou desconto exclusivo para você levar hoje mesmo! Tem alguma dúvida que eu possa ajudar?`;
                                                    const waUrl = `https://wa.me/55${rawPhone}?text=${encodeURIComponent(message)}`;
                                                %>
                                                <a href="<%= waUrl %>" target="_blank" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-1.5 px-3 rounded-lg text-xs transition flex items-center gap-1 shadow-md shadow-emerald-500/10">
                                                    <i class="fab fa-whatsapp"></i> Downsell
                                                </a>
                                            <% } %>
                                            
                                            <!-- Toggle Activities details -->
                                            <button type="button" onclick="toggleDetails('details-<%= idx %>')" class="border border-slate-200 text-slate-500 hover:bg-slate-100 font-bold py-1.5 px-3 rounded-lg text-xs transition flex items-center gap-1 cursor-pointer">
                                                <i class="fas fa-list-ul"></i> Histórico
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Collapsible Details (Activities timeline) -->
                                <div id="details-<%= idx %>" class="hidden mt-4 pt-4 border-t border-slate-100 bg-slate-50/50 rounded-lg p-4">
                                    <div class="mb-2 text-xs font-bold text-slate-400 uppercase tracking-wider">Caminho Percorrido:</div>
                                    <div class="relative border-l-2 border-slate-200 ml-2 space-y-4 py-2">
                                        <% group.activities.forEach(function(act) { %>
                                            <div class="relative pl-6">
                                                <!-- Marker dot -->
                                                <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full border-2 border-white 
                                                    <%= act.event_type === 'paid' ? 'bg-emerald-500' : 
                                                        act.event_type === 'form_submitted' ? 'bg-indigo-500' :
                                                        act.event_type === 'clicked_checkout' ? 'bg-amber-500' : 'bg-blue-500' %>">
                                                </div>
                                                <div class="flex flex-col md:flex-row justify-between md:items-center gap-1">
                                                    <div>
                                                        <span class="text-xs font-bold text-slate-700">
                                                            <% if (act.event_type === 'visited') { %>
                                                                Acessou o produto: <strong class="text-slate-800"><%= act.product_name %></strong>
                                                            <% } else if (act.event_type === 'clicked_checkout') { %>
                                                                Clicou para comprar o produto: <strong class="text-slate-800"><%= act.product_name %></strong>
                                                            <% } else if (act.event_type === 'form_submitted') { %>
                                                                Preencheu os dados de entrega: <strong class="text-slate-800"><%= act.product_name %></strong>
                                                            <% } else if (act.event_type === 'paid') { %>
                                                                Concluiu o pagamento do produto: <strong class="text-slate-800"><%= act.product_name %></strong> 🎉
                                                            <% } else { %>
                                                                Ação: <%= act.event_type %>
                                                            <% } %>
                                                        </span>
                                                        <% if (act.email || act.whatsapp) { %>
                                                            <div class="text-[11px] text-slate-500 mt-0.5">
                                                                <%= act.email ? 'E-mail: ' + act.email : '' %> 
                                                                <%= act.whatsapp ? ' | WhatsApp: ' + act.whatsapp : '' %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <span class="text-[10px] text-slate-400 font-mono">
                                                        <%= new Date(act.created_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
                                                    </span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="p-8 text-center text-slate-400">
                            Nenhum log de atividade registrado até o momento.
                        </div>
                    <% } %>
                </div>
            </form>
        </div>
    </main>

    <script>
        function toggleDetails(id) {
            const el = document.getElementById(id);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        }

        const selectAllCheckbox = document.getElementById('select-all-checkbox');
        const checkboxes = document.querySelectorAll('.log-item-checkbox');
        const deleteBtn = document.getElementById('delete-selected-btn');
        const selectedCountSpan = document.getElementById('selected-count');

        function updateDeleteButton() {
            const checkedCount = document.querySelectorAll('.log-item-checkbox:checked').length;
            selectedCountSpan.innerText = checkedCount;
            deleteBtn.disabled = checkedCount === 0;
        }

        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', (e) => {
                checkboxes.forEach(cb => cb.checked = e.target.checked);
                updateDeleteButton();
            });
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', updateDeleteButton);
        });
    </script>
</body>
</html>
