        <% } %>
        <span class="current"><%= product.nameSoft || product.name %></span>
    </div>

    <!-- PREPARE DATA -->
    <%
    let detailThumbs = [];
    if (product.image) detailThumbs.push(product.image);
    if (product.thumbs && product.thumbs.length > 0) {
        product.thumbs.forEach(function(t) {
            if (t && t.trim() !== "" && t !== product.image) detailThumbs.push(t);
        });
    }

    let avgRate = 0;
    // Filter out null/undefined reviews to avoid breaking calculations
    let safePinions = (product.pinions || []).filter(Boolean);
    let totalReviews = safePinions.length;
    if (totalReviews > 0) {
        let sum = safePinions.reduce((acc, p) => acc + (Number(p.rate) || 0), 0);
        avgRate = (sum / totalReviews).toFixed(1);
    } else {
        avgRate = "5.0";
        totalReviews = 25;
    }

    let discountPct = 0;
    if (product.priceBefore > product.price) {
        discountPct = Math.round(((product.priceBefore - product.price) / product.priceBefore) * 100);
    }

    let priceFormatted = product.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
    let priceParts = priceFormatted.split(',');
    let priceBeforeFormatted = product.priceBefore.toLocaleString('pt-BR', { minimumFractionDigits: 2 });

    const reviewNames = ["João Santos", "Mariana Oliveira", "Carlos Lima", "Ana Costa", "Rafael Silva"];
    const reviewTimes = ["Há 2 dias", "Há 5 dias", "Há 1 semana", "Há 3 dias", "Há 1 dia"];
