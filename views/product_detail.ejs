                flex-direction: column-reverse;
            }

            .pd-thumbs {
                flex-direction: row;
                overflow-x: auto;
            }

            .pd-main-image {
                min-height: 260px;
            }

            .pd-gallery-benefits {
                grid-template-columns: repeat(2, 1fr);
            }

            .pd-timer-box {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }

            .pd-price-current {
                font-size: 28px;
            }

            .pd-review-summary {
                flex-direction: column;
                align-items: center;
                gap: 16px;
            }
        }

        @media (max-width: 500px) {
            .pd-breadcrumb {
                font-size: 11px;
            }

            .pd-gallery-benefits {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .pd-os-options {
                flex-wrap: wrap;
            }

            .pd-ideal-tags {
                gap: 6px;
            }
        }

        /* --- CHECKOUT MODAL --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: #fff;
            border-radius: 24px;
            padding: 32px;
            width: 90%;
            max-width: 460px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid #e2e8f0;
            position: relative;
            transform: scale(0.9);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .modal-overlay.active .modal-content {
            transform: scale(1);
        }

        .modal-close {
            position: absolute;
            top: 18px;
            right: 22px;
            font-size: 26px;
            font-weight: 600;
            color: #94a3b8;
            cursor: pointer;
            transition: color 0.2s, transform 0.2s;
            line-height: 1;
        }

        .modal-close:hover {
            color: #334155;
            transform: scale(1.1);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 8px 0;
