            color: #94a3b8;
        }

        .pd-review-bars {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
            justify-content: center;
        }

        .pd-bar-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #64748b;
        }

        .pd-bar-label {
            width: 60px;
            font-weight: 500;
            white-space: nowrap;
        }

        .pd-bar-track {
            flex-grow: 1;
            height: 8px;
            background: #f1f5f9;
            border-radius: 4px;
            overflow: hidden;
        }

        .pd-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #3b82f6, #2563eb);
            border-radius: 4px;
            transition: width 0.6s ease;
        }

        .pd-bar-pct {
            width: 35px;
            text-align: right;
            font-weight: 600;
        }

        /* Individual reviews */
        .pd-review-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .pd-review-item {
            display: flex;
            gap: 12px;
            padding-bottom: 16px;
            border-bottom: 1px solid #f8fafc;
        }

        .pd-review-item:last-child {
            border-bottom: none;
        }

        .pd-review-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
            color: #64748b;
            flex-shrink: 0;
            overflow: hidden;
        }

        .pd-review-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .pd-review-body {
            flex-grow: 1;
        }

        .pd-review-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
            flex-wrap: wrap;
        }

        .pd-review-name {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .pd-review-badge {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 4px;
            background: #dcfce7;
            color: #16a34a;
            font-weight: 600;
        }

        .pd-review-time {
            font-size: 11px;
            color: #94a3b8;
            margin-left: auto;
        }

        .pd-review-text {
            font-size: 13px;
            color: #475569;
            line-height: 1.5;
            margin: 6px 0 0 0;
        }

        .pd-review-stars {
            display: flex;
            gap: 2px;
            margin-bottom: 2px;
        }

        .pd-review-stars i {
            font-size: 12px;
            color: #f59e0b;
        }

        .pd-btn-outline {
            display: inline-flex;
            align-items: center;
            padding: 10px 20px;
            border: 2px solid #3b82f6;
            border-radius: 10px;
            color: #3b82f6;
            font-size: 13px;
            font-weight: 600;
            background: #fff;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 16px;
            font-family: inherit;
            text-decoration: none;
        }

        .pd-btn-outline:hover {
            background: #eff6ff;
        }

        /* FAQ */
        .pd-faq-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .pd-faq-item {
            border-bottom: 1px solid #f1f5f9;
            overflow: hidden;
        }

        .pd-faq-item:last-child {
            border-bottom: none;
        }

        .pd-faq-question {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            cursor: pointer;
            transition: color 0.2s;
