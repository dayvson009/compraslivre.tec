            font-family: inherit;
            text-decoration: none;
            margin-top: 10px;
        }

        .pd-whatsapp-btn:hover {
            background: #20bd5a;
            transform: translateY(-1px);
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 1024px) {
            .pd-container {
                grid-template-columns: 1fr;
