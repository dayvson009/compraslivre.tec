                            style="background-image: url('<%= getImageUrl(img) %>')"
                            onclick="pdUpdateImage('<%= getImageUrl(img) %>', this)"></div>
                        <% } %>
                        <% }); %>
                        <% if (detailThumbs.length > 4) { %>
                        <div class="pd-thumb-more" onclick="pdShowAllThumbs()">
                            +<%= detailThumbs.length - 4 %>
                            <span>Ver mais</span>
                        </div>
                        <% } %>
                    </div>
                    <div class="pd-main-image">
                        <div class="pd-badge-bestseller"><i class="fa-solid fa-fire"></i> MAIS VENDIDO</div>
