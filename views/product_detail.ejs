            text-align: center;
            flex-shrink: 0;
        }

        .pd-review-big .big-num {
            font-size: 48px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1;
        }

        .pd-review-big .big-stars {
            display: flex;
            gap: 3px;
            justify-content: center;
            margin: 6px 0;
        }

        .pd-review-big .big-stars i {
            font-size: 16px;
            color: #3b82f6;
        }

        .pd-review-big .big-count {
