                    <div class="pd-timer-unit">
                        <span class="num" id="pd-timer-m">45</span>
                        <span class="lbl">MIN</span>
                    </div>
                    <div class="pd-timer-unit">
                        <span class="num" id="pd-timer-s">32</span>
                        <span class="lbl">SEG</span>
                    </div>
                </div>
            </div>

            <!-- Buy Card -->
            <div class="pd-buy-card">
                <p class="pd-condition">Novo | +250 vendidos</p>
                <h1 class="pd-product-name"><%= product.name %></h1>
                <p class="pd-product-subtitle"><%= product.licence %> - <%= product.formart || 'Digital' %></p>

                <!-- Rating -->
                <div class="pd-rating-row">
                    <div class="pd-stars">
                        <% for(let i=0; i<5; i++) { %>
                        <i class="fa-solid fa-star <%= i < Math.floor(avgRate) ? '' : 'empty' %>"></i>
                        <% } %>
                    </div>
                    <span class="pd-rating-num"><%= avgRate %></span>
                    <a href="#pd-reviews" class="pd-rating-link">(<%= totalReviews %> avaliações)</a>
                </div>

                <!-- Price -->
                <div class="pd-price-section">
                    <p class="pd-price-before">De R$ <%= priceBeforeFormatted %></p>
                    <div class="pd-price-row">
                        <p class="pd-price-current">R$ <%= priceParts[0] %><span class="cents">,<%= priceParts[1] %></span></p>
                        <% if (discountPct > 0) { %>
                        <span class="pd-badge-off"><%= discountPct %>% OFF</span>
                        <% } %>
                    </div>
                    <p class="pd-pix-discount">+ 5% desconto no pix</p>
                </div>

                <!-- Purchase form -->
                <form method="post" action="/buy/<%= product.id %>" id="pd-buy-form">
                    <input type="hidden" name="ip_address" id="client-ip" value="">
                    <input type="hidden" name="device" id="client-device" value="">
                    <!-- Order Bump -->
                    <% if (typeof orderbumpProduct !== 'undefined' && orderbumpProduct) { %>
                    <div class="pd-orderbump" id="ob-box">
                        <input type="checkbox" id="orderbumpId" name="orderbumpId" value="<%= orderbumpProduct.id %>"
                            onchange="toggleOrderBump(this, <%= product.price %>, <%= orderbumpProduct.price %>)">
                        <div class="pd-orderbump-content">
                            <p class="pd-orderbump-title">
                                <i class="fa-solid fa-bolt" style="color: #f59e0b;"></i>
                                Leve também: <%= orderbumpProduct.nameSoft || orderbumpProduct.name %>
                                <span class="pd-badge-offer">Oferta</span>
                            </p>
                            <p class="pd-orderbump-desc">Adicione ao seu pacote e economize com essa oferta exclusiva de <%= orderbumpProduct.licence %>.</p>
                            <p class="pd-orderbump-price">+ R$ <%= orderbumpProduct.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                        </div>
                    </div>
                    <% } %>

                    <button type="button" class="pd-btn-buy" id="btn-comprar-trigger">Comprar agora <i class="fa-solid fa-arrow-right"></i></button>

                    <!-- Checkout Modal -->
                    <div class="modal-overlay" id="checkout-modal">
                        <div class="modal-content" onclick="event.stopPropagation();">
                            <span class="modal-close" id="modal-close-btn">&times;</span>
                            <h3 class="modal-title">
                                <i class="fa-solid fa-lock" style="color: #22c55e;"></i>
                                Concluir Compra
                            </h3>
                            <p class="modal-subtitle">Preencha seus dados para receber o produto imediatamente.</p>

                            <div class="pd-form-group">
                                <label for="email"><i class="fa-regular fa-envelope"></i> E-mail para entrega</label>
                                <input id="email" name="email" type="email" placeholder="onde você receberá o produto" required>
                            </div>
                            <div class="pd-form-group">
                                <label for="whatsapp"><i class="fa-brands fa-whatsapp"></i> WhatsApp (com DDD)</label>
                                <input id="whatsapp" name="whatsapp" type="text" placeholder="(11) 99999-9999" required>
                            </div>

                            <button type="submit" class="pd-btn-buy">Continuar compra <i class="fa-solid fa-arrow-right"></i></button>
                        </div>
                    </div>
                </form>

                <!-- Safe alert -->
                <div class="pd-safe-alert">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span><strong>Compra Segura!</strong> O acesso será enviado IMEDIATAMENTE após a confirmação do PIX.</span>
                </div>

                <!-- Favorite -->
                <button class="pd-btn-fav" id="pd-fav-btn" onclick="pdToggleFavorite('<%= product.id %>')">
                    <i class="fa-regular fa-heart"></i> Adicionar aos favoritos
                </button>

                <!-- WhatsApp -->
                <a href="https://wa.me/5581985315669?text=Ol%C3%A1%2C%20tenho%20d%C3%BAvidas%20sobre%20o%20produto%20<%= encodeURIComponent(product.name) %>"
                    target="_blank" class="pd-whatsapp-btn">
                    <i class="fa-brands fa-whatsapp" style="font-size: 18px;"></i> Fale com Suporte
                </a>

                <!-- Security -->
                <div class="pd-security-row">
                    <i class="fa-solid fa-shield-check"></i>
                    <div>
                        <div class="sec-text">Compra 100% segura</div>
                        <div class="sec-sub">Seus dados protegidos</div>
                    </div>
                </div>

                <!-- Payment methods -->
                <div class="pd-payment-section">
                    <p class="pd-payment-title">Formas de pagamento</p>
                    <div class="pd-payment-icons">
                        <div class="pd-payment-icon pd-pay-pix">PIX</div>
                        <div class="pd-payment-icon pd-pay-visa">VISA</div>
                        <div class="pd-payment-icon">
                            <svg width="32" height="20" viewBox="0 0 32 20" fill="none">
                                <circle cx="12" cy="10" r="8" fill="#EB001B" />
                                <circle cx="20" cy="10" r="8" fill="#F79E1B" />
                                <path d="M16 4.8C17.7 6.2 18.8 8 18.8 10s-1.1 3.8-2.8 5.2C14.3 13.8 13.2 12 13.2 10s1.1-3.8 2.8-5.2z" fill="#FF5F00" />
                            </svg>
                        </div>
                        <div class="pd-payment-icon" style="font-size: 9px; font-weight: 800; color: #006FCF;">AMEX</div>
                        <div class="pd-payment-icon pd-pay-boleto">
                            <i class="fa-solid fa-barcode" style="font-size: 16px; color: #475569;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- END pd-container -->

    <!-- REVIEWS + FAQ -->
    <div class="pd-reviews-faq-section">
        <!-- Reviews -->
        <div class="pd-review-card" id="pd-reviews">
            <h3 class="pd-section-header"><i class="fa-solid fa-star"></i> Avaliações de clientes</h3>

            <div class="pd-review-summary">
                <div class="pd-review-big">
                    <div class="big-num"><%= avgRate %></div>
                    <div class="big-stars">
                        <% for(let i=0; i<5; i++) { %>
                        <i class="fa-solid fa-star" style="color: <%= i < Math.floor(avgRate) ? '#3b82f6' : '#e2e8f0' %>;"></i>
                        <% } %>
                    </div>
                    <div class="big-count">Baseado em <%= totalReviews %> avaliações</div>
                </div>
                <div class="pd-review-bars">
                    <%
                    let starCounts = [0,0,0,0,0];
                    if (safePinions.length > 0) {
                        safePinions.forEach(function(p) {
                            let r = Math.min(5, Math.max(1, Math.round(Number(p.rate) || 5)));
                            starCounts[r-1]++;
                        });
                    }
                    let total = Math.max(1, safePinions.length);
                    %>
                    <% for(let s=5; s>=1; s--) { %>
                    <% let pct = Math.round((starCounts[s-1] / total) * 100); %>
                    <div class="pd-bar-row">
                        <span class="pd-bar-label"><%= s %> estrela<%= s > 1 ? 's' : '' %></span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width: <%= pct %>%;"></div>
                        </div>
                        <span class="pd-bar-pct"><%= pct %>%</span>
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="pd-review-list">
                <% if (safePinions.length > 0) { %>
                <% safePinions.forEach(function(op, idx) { %>
                <div class="pd-review-item">
                    <div class="pd-review-avatar">
                        <% if (op.image && op.image.length > 0) { %>
                        <img src="<%= getImageUrl(op.image) %>" alt="Review">
                        <% } else { %>
                        <%= reviewNames[idx % reviewNames.length].charAt(0) %>
                        <% } %>
                    </div>
                    <div class="pd-review-body">
                        <div class="pd-review-meta">
                            <span class="pd-review-name"><%= reviewNames[idx % reviewNames.length] %></span>
                            <span class="pd-review-badge">Comprador verificado</span>
                            <span class="pd-review-time"><%= reviewTimes[idx % reviewTimes.length] %></span>
                        </div>
                        <div class="pd-review-stars">
                            <% for(let i=0; i < Number(op.rate); i++) { %>
                            <i class="fa-solid fa-star"></i>
                            <% } %>
                        </div>
                        <p class="pd-review-text"><%= op.pinion %></p>
                    </div>
                </div>
                <% }); %>
                <% } %>
            </div>
            <a href="#pd-reviews" class="pd-btn-outline">Ver todas avaliações</a>
        </div>

        <!-- FAQ -->
        <div class="pd-faq-card">
            <h3 class="pd-section-header"><i class="fa-solid fa-circle-question" style="color: #3b82f6;"></i> Perguntas frequentes</h3>

            <div class="pd-faq-list">
                <% if (product.questions && product.questions.length > 0) { %>
                <% product.questions.forEach(function(q, idx) { %>
                <div class="pd-faq-item">
                    <div class="pd-faq-question" onclick="pdToggleFaq(this)">
                        <span><%= q.question %></span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="pd-faq-answer"><%= q.resp %></div>
                </div>
                <% }); %>
                <% } %>
            </div>

            <!-- Ask question via WhatsApp -->
            <form onsubmit="enviarWhatsApp(event)" style="display: flex; gap: 10px; margin-top: 20px;">
                <input type="text" id="pergunta" placeholder="Escreva sua pergunta..." required
                    style="flex-grow: 1; padding: 12px 14px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; font-family: inherit; background: #f8fafc; color: #334155; transition: all 0.2s;">
                <button type="submit"
                    style="padding: 0 20px; border-radius: 10px; border: none; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; font-weight: 700; cursor: pointer; font-family: inherit; font-size: 14px; white-space: nowrap;">
                    Perguntar
                </button>
            </form>

            <a href="#pd-reviews" class="pd-btn-outline" style="border-color: #e2e8f0; color: #64748b;">Ver mais perguntas</a>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script>
        // URL Hash for tracking
        window.location.hash = "?seller=202452-2025423598756&reco_id=d0bc7325-d0a6-4e93-814f-7c7ec4387922&sid=recos&is_advertising=true&ad_domain=VIPDESKTOP_UP&ad_position=2&ad_click_id=MjQ4MTRhYmUtNzRlMC00YzM3LTg0ODgtOGQ4OGMzMzA0OGQx";

        // ---- GALLERY ----
        function pdUpdateImage(url, el) {
            document.getElementById('pd-view-img').src = url;
            document.querySelectorAll('.pd-thumb').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
        }

        function pdShowAllThumbs() {
            const thumbMore = document.querySelector('.pd-thumb-more');
            if (thumbMore) thumbMore.style.display = 'none';
        }

        // ---- COUNTDOWN TIMER ----
        (function () {
            let totalSeconds = Math.floor(Math.random() * 36000) + 7200;
            const savedEnd = sessionStorage.getItem('pd_timer_end');
            if (savedEnd) {
                const remaining = Math.floor((parseInt(savedEnd) - Date.now()) / 1000);
                if (remaining > 0) {
                    totalSeconds = remaining;
                } else {
                    totalSeconds = Math.floor(Math.random() * 36000) + 7200;
                    sessionStorage.setItem('pd_timer_end', Date.now() + totalSeconds * 1000);
                }
            } else {
                sessionStorage.setItem('pd_timer_end', Date.now() + totalSeconds * 1000);
            }

            function updateTimer() {
                if (totalSeconds <= 0) {
                    totalSeconds = Math.floor(Math.random() * 36000) + 7200;
                    sessionStorage.setItem('pd_timer_end', Date.now() + totalSeconds * 1000);
                }
                const h = Math.floor(totalSeconds / 3600);
                const m = Math.floor((totalSeconds % 3600) / 60);
                const s = totalSeconds % 60;
                document.getElementById('pd-timer-h').textContent = String(h).padStart(2, '0');
                document.getElementById('pd-timer-m').textContent = String(m).padStart(2, '0');
                document.getElementById('pd-timer-s').textContent = String(s).padStart(2, '0');
                totalSeconds--;
            }
            updateTimer();
            setInterval(updateTimer, 1000);
        })();

        // ---- OS SELECTOR ----
        function pdSelectOS(btn) {
            document.querySelectorAll('.pd-os-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        // ---- FAQ ACCORDION ----
        function pdToggleFaq(el) {
            const item = el.closest('.pd-faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.pd-faq-item').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }

        // ---- FAVORITES ----
        function pdToggleFavorite(productId) {
            const btn = document.getElementById('pd-fav-btn');
            let favs = JSON.parse(localStorage.getItem('favorited_products') || '[]');
            const idx = favs.indexOf(productId);
            if (idx > -1) {
                favs.splice(idx, 1);
                btn.classList.remove('favorited');
                btn.innerHTML = '<i class="fa-regular fa-heart"></i> Adicionar aos favoritos';
            } else {
                favs.push(productId);
                btn.classList.add('favorited');
                btn.innerHTML = '<i class="fa-solid fa-heart"></i> Nos favoritos';
            }
            localStorage.setItem('favorited_products', JSON.stringify(favs));
            if (typeof updateNavFavoritesCount === 'function') updateNavFavoritesCount();
        }

        // Check if already favorited on load
        document.addEventListener('DOMContentLoaded', function () {
            const favs = JSON.parse(localStorage.getItem('favorited_products') || '[]');
            if (favs.includes('<%= product.id %>')) {
                const btn = document.getElementById('pd-fav-btn');
                btn.classList.add('favorited');
                btn.innerHTML = '<i class="fa-solid fa-heart"></i> Nos favoritos';
            }
        });

        // ---- WHATSAPP QUESTION ----
        function enviarWhatsApp(event) {
            event.preventDefault();
            const numero = "5581985315669";
            const pergunta = document.getElementById('pergunta').value;
            const mensagem = encodeURIComponent(pergunta);
            window.open(`https://wa.me/${numero}?text=_<%= product.name %>_%0A*Pergunta:*%0A${mensagem}`, '_blank');
        }

        // ---- ORDER BUMP ----
        function toggleOrderBump(checkbox, mainPrice, bumpPrice) {
            const box = document.getElementById('ob-box');
            if (checkbox.checked) {
                box.classList.add('active');
            } else {
                box.classList.remove('active');
            }
        }

        // ---- DEVICE & IP DETECTOR ----
        let clientIP = '';
        const clientDevice = /Mobi|Android/i.test(navigator.userAgent) ? 'Mobile' : 'Desktop';
        const deviceInput = document.getElementById('client-device');
        if (deviceInput) deviceInput.value = clientDevice;

        async function fetchClientIP() {
            try {
                const response = await fetch('https://ifconfig.me/ip');
                const data = await response.text();
                clientIP = data;
                const ipInput = document.getElementById('client-ip');
                if (ipInput) ipInput.value = clientIP;
            } catch (error) {
                console.error('Erro ao obter o endereço IP:', error);
            }
        }

        // Registrar visita no frontend usando IP externo real
        fetchClientIP().then(() => {
            fetch('/track-event', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    eventType: 'visited',
                    productId: '<%= product.id %>',
                    ipAddress: clientIP,
                    device: clientDevice
                })
            }).catch(e => console.error('Erro ao enviar tracking de visita:', e));
        });

        // ---- WHATSAPP MASK ----
        document.getElementById('whatsapp').addEventListener('input', function (e) {
            var x = e.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
            e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
        });

        // ---- CHECKOUT MODAL LOGIC ----
        const modal = document.getElementById('checkout-modal');
        const openBtn = document.getElementById('btn-comprar-trigger');
        const closeBtn = document.getElementById('modal-close-btn');

        if (openBtn && modal && closeBtn) {
            openBtn.addEventListener('click', function(e) {
                e.preventDefault();
                modal.classList.add('active');

                // Enviar tracking event
                fetch('/track-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        eventType: 'clicked_checkout',
                        productId: '<%= product.id %>',
                        ipAddress: clientIP,
                        device: clientDevice
                    })
                }).catch(e => console.error('Erro ao enviar tracking:', e));
            });

            closeBtn.addEventListener('click', function() {
                modal.classList.remove('active');
            });

            modal.addEventListener('click', function() {
                modal.classList.remove('active');
            });
        }
    </script>

    <%- include('partials/footer') %>
</body>

</html>