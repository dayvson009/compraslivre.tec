            transition: transform 0.3s;
            flex-shrink: 0;
        }

        .pd-faq-item.open .pd-faq-question i {
            transform: rotate(180deg);
        }

        .pd-faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.35s ease, padding 0.35s ease;
            font-size: 13px;
            color: #64748b;
            line-height: 1.6;
            padding: 0;
        }

        .pd-faq-item.open .pd-faq-answer {
